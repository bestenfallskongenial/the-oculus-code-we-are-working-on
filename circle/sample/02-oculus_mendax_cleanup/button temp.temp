#include "kernel.h"

// Demonstration version: true double-click semantics.
// Timestamp slots used as:
// [0] = press start time
// [1] = double-click event flag (1 when second click is detected)
// [2] = long-click state flag (1 while held beyond lng_clk_time)
// [3] = last release time
void CKernel::button_ping (int btn_id)
{
    // Read physical pin state - pull-up input: 0 = pressed, 1 = released
    buttons_states[0] = CGPIOPin(SW_PIN_A, GPIOModeInputPullUp).Read();
    buttons_states[1] = CGPIOPin(SW_PIN_B, GPIOModeInputPullUp).Read();

    // Clear one-shot double-click event each iteration.
    buttons_pressed_timestamps[btn_id][1] = 0;

    if (buttons_states[btn_id] == ISPRESSED)
    {
        // New press edge (first loop iteration where button is down)
        if (buttons_pressed_timestamps[btn_id][0] == 0)
        {
            buttons_pressed_timestamps[btn_id][0] = currentTime;

            // True double-click check: previous release exists and second press is soon enough.
            if (buttons_pressed_timestamps[btn_id][3] > 0
                && (currentTime - buttons_pressed_timestamps[btn_id][3]) < dbl_clk_time)
            {
                buttons_pressed_timestamps[btn_id][1] = 1;
            }
        }

        // Long-click state while button remains held down.
        if ((currentTime - buttons_pressed_timestamps[btn_id][0]) > lng_clk_time)
        {
            buttons_pressed_timestamps[btn_id][2] = 1;
        }
    }
    else
    {
        // Release edge: only process if it had been pressed.
        if (buttons_pressed_timestamps[btn_id][0] > 0)
        {
            buttons_pressed_timestamps[btn_id][3] = currentTime;
            buttons_pressed_timestamps[btn_id][0] = 0;
        }

        // Not held anymore.
        buttons_pressed_timestamps[btn_id][2] = 0;
    }
}

// okay, now we need a "consumer" that uses the informations from the button_ping function, the state array to increment a &variable on single click

void CKernel::button_consumer_A()
{
    // Example consumer logic for button A (btn_id = 0)
    if (buttons_pressed_timestamps[0][1] == 1) // If double-click detected
    {
        // Handle double-click event for button A
        // For example, increment a variable or trigger an action
        someVariable++;
        buttons_pressed_timestamps[0][1] == 0; // Reset double-click flag after handling        
    }
    
    if (buttons_pressed_timestamps[0][2] == 1) // If long-click active
    {
        // Handle long-click state for button A
        // For example, perform a different action while the button is held
        performLongClickAction();
    }
}

void CKernel::button_consumer_B()
{
    // If single-click detected
    if (buttons_pressed_timestamps[1][0] > 0 && buttons_pressed_timestamps[1][1] == 0) // If button is pressed but not double-clicked
    {
        // Handle single-click event for button B
        someOtherVariableA++;
    }    
    // Example consumer logic for button B (btn_id = 1)
    if (buttons_pressed_timestamps[1][1] == 1) // If double-click detected
    {
        // Handle double-click event for button B
        someOtherVariableB++;
        buttons_pressed_timestamps[1][1] == 0; // Reset double-click flag after handling
    }
    
    if (buttons_pressed_timestamps[1][2] == 1) // If long-click active
    {
        // Handle long-click state for button B
        performOtherLongClickAction();

    }
}
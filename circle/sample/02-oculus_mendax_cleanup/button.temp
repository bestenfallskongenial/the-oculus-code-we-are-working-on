#include "kernel.h"

// Demonstration version: true double-click semantics.
// Timestamp slots used as:
// [0] = press start time
// [1] = double-click event flag (1 when second click is detected)
// [2] = long-click state flag (1 while held beyond lng_clk_time)
// [3] = last release time

// somehow the ai thinks this code is not sufficient to provide meaningful results
// and creates consumer functions wiith additional poller / state machines
// i wonder why it does that, since the code is pretty straightforward and self-contained, but maybe it just wants to show off its capabilities. 
// anyway, here is the button_ping function that processes button states and 
// updates timestamps for press, release, double-click, and long-click detection.

void CKernel::button_ping (int btn_id)
{
    // Read physical pin state - pull-up input: 0 = pressed, 1 = released
    buttons_states[0] = CGPIOPin(SW_PIN_A, GPIOModeInputPullUp).Read();
    buttons_states[1] = CGPIOPin(SW_PIN_B, GPIOModeInputPullUp).Read();

    // Clear one-shot double-click event each iteration.
    buttons_pressed_timestamps[btn_id][1] = 0;

    if (buttons_states[btn_id] == ISPRESSED)
    {
        // New press edge (first loop iteration where button is down)
        if (buttons_pressed_timestamps[btn_id][0] == 0)
        {
            buttons_pressed_timestamps[btn_id][0] = currentTime;

            // True double-click check: previous release exists and second press is soon enough.
            if (buttons_pressed_timestamps[btn_id][3] > 0
                && (currentTime - buttons_pressed_timestamps[btn_id][3]) < dbl_clk_time)
            {
                buttons_pressed_timestamps[btn_id][1] = 1;
            }
        }

        // Long-click state while button remains held down.
        if ((currentTime - buttons_pressed_timestamps[btn_id][0]) > lng_clk_time)
        {
            buttons_pressed_timestamps[btn_id][2] = 1;
        }
    }
    else
    {
        // Release edge: only process if it had been pressed.
        if (buttons_pressed_timestamps[btn_id][0] > 0)
        {
            buttons_pressed_timestamps[btn_id][3] = currentTime;
            buttons_pressed_timestamps[btn_id][0] = 0;
        }

        // Not held anymore.
        buttons_pressed_timestamps[btn_id][2] = 0;
    }
}

// time for a common consumer function, simply & refering tw0 variables 
// for the test like single click increment,  long press decrement, double click reset
// but first i need to know thy the ai is claiming
// Addressed the single-click logic issue for button B by triggering single-click on release edge and excluding double/long cases, instead of treating “currently pressed” as single-click. 
// or Single-click” condition is wrong
//buttons_pressed_timestamps[1][0] > 0 means “currently pressed / press timestamp exists”, not “single-click event completed”. It will fire repeatedly while held.

//No one-shot consumption for double-click
//If [1] is a one-shot event flag, it should be cleared after handling, otherwise it can retrigger.

// Missing release-edge logic for short press
//A short/single click is usually confirmed on release, not while still pressed.

//Placeholders are undefined
//someOtherVariableA/B and performOtherLongClickAction() are just pseudo symbols, not real code.

void CKernel::button_consume (int btn_id)
{
    // Single-click: only on release edge, if not a double-click or long-click.
    if (buttons_pressed_timestamps[btn_id][3] > 0 // A release has occurred
        && buttons_pressed_timestamps[btn_id][1] == 0 // Not a double-click
        && buttons_pressed_timestamps[btn_id][2] == 0) // Not a long-click
    {
        someOtherVariableA++; // Increment on single click
    }

    // Double-click: one-shot event flag is set.
    if (buttons_pressed_timestamps[btn_id][1] == 1)
    {
        someOtherVariableB = 0; // Reset on double click
        buttons_pressed_timestamps[btn_id][1] = 0; // Clear one-shot flag
    }

    // Long-click: state flag is set while held.
    if (buttons_pressed_timestamps[btn_id][2] == 1)
    {
        performOtherLongClickAction(); // Perform long-click action
        // Note: This will trigger repeatedly while held, which may be intended for continuous action.
    }
}